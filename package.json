{
  "name": "meltify-ts",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of meltify (meltify-info parity): derive an identity report from an Ed25519 OpenSSH key.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:core": "esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/core-neutral-check.mjs --log-level=warning",
    "verify": "npm run typecheck && npm run demo:typecheck && npm run site:typecheck && npm run test && npm run check:core && npm run build",
    "demo": "node examples/browser-demo/dev.mjs",
    "demo:build": "esbuild examples/browser-demo/app.ts --bundle --platform=browser --format=esm --outfile=examples/browser-demo/app.js --sourcemap --log-level=warning",
    "demo:typecheck": "tsc -p examples/browser-demo/tsconfig.json",
    "site:dev": "node site/serve.mjs --build --dev",
    "site:build": "node site/build.mjs",
    "site:serve": "node site/serve.mjs",
    "site:typecheck": "tsc -p site/tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
