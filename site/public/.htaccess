# cPanel / Apache deployment for the meltify site.
#
# The page makes no network requests; this file is what makes that a property
# of the deployment rather than of one server you configured once. Upload the
# contents of site/dist/ (this file included) into public_html/.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Hashed assets never change name; the shell must always be revalidated.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType application/json .map
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# No directory listing, no server signatures.
Options -Indexes
ServerSignature Off

